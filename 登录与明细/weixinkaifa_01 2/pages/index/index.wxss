.container { 
  background: #f5f5f5; 
  min-height: 100vh;
  padding-top: 0;
  margin-top: 0;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #07c160;
  color: white;
  margin: 0;
}

.filter-item {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 26rpx;
  text-align: center;
  color: white;
}

.filter-btn {
  background: rgba(255, 255, 255, 0.3);
  font-weight: bold;
  padding: 8rpx 24rpx;
}

/* 顶部卡片 */
.header-card {
  background: #07c160;
  color: white;
  padding: 30rpx;
  border-radius: 0;
  width: 100%;
  margin: 0;
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 30rpx;
}
.title { font-size: 40rpx; font-weight: 500; }
.month { font-size: 32rpx; opacity: 0.9; }
.card-stats { 
  display: flex; 
  justify-content: space-around; 
  padding: 0 30rpx; 
}
.stat {
   text-align: center;
   }
.label { 
   font-size: 28rpx;
   opacity: 0.8; 
   display: block; 
   margin-bottom: 10rpx;
  }
.value { font-size: 36rpx; font-weight: 500; }
.value.expense { color: #ff4d4f; }
.value.income { color: #fff; }

/* 记录列表 */
.record-list { width: 100%; }
.date-group { background: #fff; margin: 20rpx; border-radius: 16rpx; overflow: hidden; }
.date-header {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-text { 
  font-size: 32rpx;
   color: #333; 
  }
.date-summary { 
  font-size: 26rpx;
 }
.date-summary .out {
   color: #ff4d4f; 
  margin-right: 15rpx;
 }
.date-summary .in { 
  color: #07c160;
 }

.record-item {
  padding: 25rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
}
.record-item:last-child {
   border-bottom: none; 
  }
.record-left { 
  display: flex; 
  align-items: center; 
  gap: 20rpx; 
}
.type-icon {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  color: #fff; display: flex; align-items: center; justify-content: center;
}
.record-info { 
  display: flex; 
  flex-direction: column
}
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  background: #07c160;
  color: white;
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  z-index: 999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ==================== 筛选弹窗样式（新增） ==================== */

.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.filter-content {
  background: white;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.filter-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.filter-option {
  padding: 16rpx 30rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  min-width: 160rpx;
  border: 2rpx solid transparent;
}

.filter-option.active {
  background: #e6f7ed;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.filter-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-btn-cancel {
  flex: 1;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
}

.filter-btn-confirm {
  flex: 1;
  padding: 24rpx;
  background: #07c160;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: white;
}
.delete-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-content {
  background: white;
  border-radius: 24rpx;
  padding: 50rpx 60rpx;
  width: 70%;
  text-align: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.delete-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.delete-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.delete-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.delete-btns {
  display: flex;
  gap: 20rpx;
}

.delete-btn-cancel {
  flex: 1;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
}

.delete-btn-confirm {
  flex: 1;
  padding: 24rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: white;
}