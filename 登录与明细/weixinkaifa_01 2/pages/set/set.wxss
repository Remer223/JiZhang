.container{
  padding: 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.user-card{
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar{
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.info{
  flex:1;
}

.nickname{
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.account{
  font-size: 26rpx;
  color:#666;
}

.arrow{
  font-size: 32rpx;
  color:#ccc;
}

.item{
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.time{
  color:#07c160;
  font-size: 28rpx;
}