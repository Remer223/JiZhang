.container {
  padding: 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.user-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #e0e0e0;
  margin-bottom: 20rpx;
}

.info {
  text-align: center;
}

.nickname {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.phone {
  font-size: 28rpx;
  color: #999;
}

.menu {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-section {
  padding: 0 30rpx;
}

.logout-btn {
  width: 100%;
  background: #fff;
  color: #ff4d4f;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: 1rpx solid #ff4d4f;
}