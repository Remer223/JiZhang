<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.accountbookserver.mapper.UserMapper">

    <select id="findByPhone" resultType="org.example.accountbookserver.entity.User">
        SELECT * FROM t_user WHERE phone = #{phone}
    </select>

    <insert id="insert" parameterType="org.example.accountbookserver.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (phone, password, nickname, avatar)
        VALUES (#{phone}, #{password}, #{nickname}, #{avatar})
    </insert>

    <update id="updatePassword" parameterType="org.example.accountbookserver.entity.User">
        UPDATE t_user SET password = #{password} WHERE id = #{id}
    </update>

    <update id="updateProfile" parameterType="org.example.accountbookserver.entity.User">
        UPDATE t_user SET nickname = #{nickname}, avatar = #{avatar} WHERE id = #{id}
    </update>

</mapper>
