<!--pages/reset-password/reset-password.wxml-->
<view class="container">
  <view class="title">重置密码</view>
  <view class="desc">请输入手机号获取图片验证码</view>

  <!-- 手机号 -->
  <view class="item">
    <text class="label">手机号</text>
    <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="inputPhone" />
  </view>

  <!-- 图形验证码 -->
  <view class="captcha-section">
    <view class="item captcha-item">
      <text class="label">验证码</text>
      <input class="input captcha-input" placeholder="请输入验证码" value="{{captcha}}" bindinput="inputCaptcha" />
    </view>
    <view class="captcha-img-wrap" bindtap="getCaptcha">
      <image wx:if="{{captchaImage}}" src="{{captchaImage}}" class="captcha-img" mode="aspectFit" />
      <view wx:else class="captcha-placeholder">
        <text>{{captchaImage ? '' : '点击获取'}}</text>
      </view>
    </view>
  </view>

  <!-- 新密码 -->
  <view class="item">
    <text class="label">新密码</text>
    <input class="input" password="{{true}}" placeholder="请输入新密码（至少6位）" value="{{newPassword}}" bindinput="inputNewPassword" />
  </view>

  <!-- 确认按钮 -->
  <button class="submit-btn" bindtap="submitReset">确认修改</button>
</view>
