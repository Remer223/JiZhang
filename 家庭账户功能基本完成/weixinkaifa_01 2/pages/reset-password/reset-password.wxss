.container {
  padding: 40rpx 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 50rpx;
}

.item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  width: 120rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

/* 验证码区域 */
.captcha-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.captcha-item {
  flex: 1;
  margin-bottom: 0;
}

.captcha-input {
  flex: 1;
}

.captcha-img-wrap {
  width: 200rpx;
  height: 76rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.captcha-img {
  width: 100%;
  height: 100%;
}

.captcha-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #07c160;
}

.submit-btn {
  margin-top: 60rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 44rpx;
}
