<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <picker mode="selector" range="{{yearList}}" value="{{currentYearIndex}}" bindchange="onYearChange">
      <view class="filter-item">{{currentYear}}年 ▼</view>
    </picker>
    <picker mode="selector" range="{{monthList}}" value="{{currentMonthIndex}}" bindchange="onMonthChange">
      <view class="filter-item">{{currentMonth}}月 ▼</view>
    </picker>
    <picker mode="selector" range="{{dayList}}" value="{{currentDayIndex}}" bindchange="onDayChange">
      <view class="filter-item">{{currentDay ? currentDay + '日' : '全部'}} ▼</view>
    </picker>
    <view class="filter-item filter-btn" bindtap="openFilterModal">
      <text>筛选 ▼</text>
    </view>
  </view>

  <!-- 顶部绿色统计卡片 -->
  <view class="header-card">
    <view class="card-top">
      <text class="title">记账本</text>
      <text class="month">{{currentMonthText}}</text>
    </view>
    <view class="card-stats">
      <view class="stat">
        <text class="label">总支出</text>
        <text class="value expense">¥{{totalExpense}}</text>
      </view>
      <view class="stat">
        <text class="label">总收入</text>
        <text class="value income">¥{{totalIncome || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 可滑动的记录列表 -->
  <scroll-view class="record-list" scroll-y style="height: calc(100vh - 420rpx);">
    <block wx:for="{{recordGroups}}" wx:key="dateText">
      <view class="date-group">
        <view class="date-header">
          <text class="date-text">{{item.dateText}}</text>
          <view class="date-summary">
            <text class="out">出 ¥{{item.dayExpense}}</text>
            <text class="in">入 ¥{{item.dayIncome}}</text>
          </view>
        </view>

        <view
          class="record-item"
          wx:for="{{item.records}}"
          wx:for-item="record"
          wx:key="id"
          bindlongpress="onLongPressRecord"
          data-id="{{record.id}}"
          data-category="{{record.category}}"
          data-amount="{{record.amount}}"
          data-type="{{record.type}}">

          <view class="record-left">
            <view class="type-icon" style="background-color: {{record.typeColor}}">
              {{record.typeIcon}}
            </view>
            <view class="record-info">
              <view class="type-name-row">
                <text class="type-name">{{record.typeName}}</text>
                <!-- 家庭数据来源标签：昵称(角色) -->
                <text class="source-tag" wx:if="{{record.sourceTag}}">{{record.sourceTag}}</text>
              </view>
              <text class="record-desc">{{record.time}} {{record.remark ? '| ' + record.remark : ''}}</text>
            </view>
          </view>
          <view class="record-amount {{record.type === 1 ? 'expense' : 'income'}}">
            {{record.type === 1 ? '-' : '+'}}¥{{record.amount}}
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{recordGroups.length === 0}}" class="empty-state">
      <text>暂无记录</text>
    </view>
  </scroll-view>

  <view class="fab" bindtap="goToAdd">
    <text>记一笔</text>
  </view>

  <!-- 筛选弹窗 -->
  <view wx:if="{{showFilterModal}}" class="filter-modal" catchtap="preventClose">
    <view class="filter-content">
      <view class="filter-header">
        <text class="filter-title">选择筛选项</text>
        <text class="filter-close" bindtap="closeFilterModal">✕</text>
      </view>

      <!-- 收支类型 -->
      <view class="filter-section">
        <text class="filter-label">收支类型</text>
        <view class="filter-options">
          <view
            wx:for="{{typeFilterList}}"
            wx:key="value"
            class="filter-option {{filterType === item.value ? 'active' : ''}}"
            bindtap="selectTypeFilter"
            data-value="{{item.value}}">
            {{item.label}}
          </view>
        </view>
      </view>

      <!-- 交易类型 -->
      <view class="filter-section">
        <text class="filter-label">交易类型</text>
        <view class="filter-options">
          <view
            wx:for="{{categoryFilterList}}"
            wx:key="name"
            class="filter-option {{filterCategory === item.name ? 'active' : ''}}"
            bindtap="selectCategoryFilter"
            data-name="{{item.name}}">
            {{item.icon}} {{item.name}}
          </view>
        </view>
      </view>

      <!-- ★ 家庭成员筛选（仅在有家庭时显示） -->
      <view class="filter-section" wx:if="{{isInFamily && familyMemberList.length > 0}}">
        <text class="filter-label">家庭成员</text>
        <view class="filter-options">
          <view
            class="filter-option {{filterMemberId === 0 ? 'active' : ''}}"
            bindtap="selectMemberFilter"
            data-userid="0">
            全部
          </view>
          <view
            wx:for="{{familyMemberList}}"
            wx:key="userId"
            class="filter-option {{filterMemberId === item.userId ? 'active' : ''}}"
            bindtap="selectMemberFilter"
            data-userid="{{item.userId}}">
            {{item.nickname}}({{item.role}})
          </view>
        </view>
      </view>

      <!-- 底部按钮 -->
      <view class="filter-footer">
        <view class="filter-btn-cancel" bindtap="resetFilter">重置</view>
        <view class="filter-btn-confirm" bindtap="confirmFilter">确定</view>
      </view>
    </view>
  </view>

  <!-- 删除确认弹窗 -->
  <view wx:if="{{showDeleteModal}}" class="delete-modal" catchtap="preventClose">
    <view class="delete-content">
      <view class="delete-icon">🗑️</view>
      <text class="delete-title">确认删除</text>
      <text class="delete-desc" wx:if="{{deleteRecordInfo}}">
        {{deleteRecordInfo.type}}：{{deleteRecordInfo.category}} ¥{{deleteRecordInfo.amount}}
      </text>
      <text class="delete-desc" wx:else>确定要删除这条记录吗？</text>
      <view class="delete-btns">
        <view class="delete-btn-cancel" bindtap="closeDeleteModal">取消</view>
        <view class="delete-btn-confirm" bindtap="confirmDelete">删除</view>
      </view>
    </view>
  </view>
</view>
