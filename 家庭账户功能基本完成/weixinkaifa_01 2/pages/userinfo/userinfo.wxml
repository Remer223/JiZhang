<!--pages/userinfo/userinfo.wxml-->
<view class="container">

  <!-- ========== 登录模式 ========== -->
  <block wx:if="{{mode === 'login'}}">
    <view class="welcome-area">
      <text class="welcome-icon">📒</text>
      <text class="welcome-title">欢迎使用记账本</text>
      <text class="welcome-sub">记录每一笔，生活更清晰</text>
    </view>

    <view class="item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="inputPhone" />
    </view>

    <view class="item">
      <text class="label">密码</text>
      <input class="input" password="{{true}}" placeholder="请输入密码" value="{{password}}" bindinput="inputPassword" />
    </view>

    <button class="login-btn" bindtap="login">登 录</button>

    <view class="bottom-links">
      <text class="link" bindtap="switchToRegister">没有账号？立即注册</text>
      <text class="link" bindtap="goToResetPassword">忘记密码？</text>
    </view>
  </block>

  <!-- ========== 注册模式 ========== -->
  <block wx:if="{{mode === 'register'}}">
    <view class="welcome-area">
      <text class="welcome-icon">✨</text>
      <text class="welcome-title">注册新账号</text>
      <text class="welcome-sub">加入我们，开始记账之旅</text>
    </view>

    <view class="item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="inputPhone" />
    </view>

    <view class="item">
      <text class="label">昵称</text>
      <input class="input" placeholder="给自己起个名字" value="{{nickname}}" bindinput="inputNickname" />
    </view>

    <view class="item">
      <text class="label">密码</text>
      <input class="input" password="{{true}}" placeholder="至少6位密码" value="{{password}}" bindinput="inputPassword" />
    </view>

    <button class="login-btn" bindtap="doRegister">注 册</button>

    <view class="bottom-links">
      <text class="link" bindtap="switchToLogin">已有账号？返回登录</text>
    </view>
  </block>

  <!-- ========== 编辑资料模式 ========== -->
  <block wx:if="{{mode === 'edit'}}">
    <view class="avatar-section" bindtap="chooseAvatar">
      <image src="{{avatar}}" class="avatar-img" wx:if="{{avatar}}"></image>
      <view class="avatar-placeholder" wx:else></view>
      <text class="change-text">点击更换头像</text>
    </view>

    <view class="item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" disabled />
    </view>

    <view class="item">
      <text class="label">昵称</text>
      <input class="input" placeholder="请输入昵称" value="{{nickname}}" bindinput="inputNickname" />
    </view>

    <button class="login-btn" bindtap="submit">保存</button>
  </block>

</view>
