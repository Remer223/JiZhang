.container {
  padding: 20rpx 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 欢迎区域 */
.welcome-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}
.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}
.welcome-sub {
  font-size: 26rpx;
  color: #999;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #07c160;
}
.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #07c160;
  background: #e0e0e0;
}
.change-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666;
}

/* 表单项 */
.item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  width: 120rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

/* 按钮 */
.login-btn {
  margin-top: 60rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
}

/* 底部链接 */
.bottom-links {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  gap: 20rpx;
}
.link {
  font-size: 28rpx;
  color: #07c160;
}
